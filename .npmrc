# Supply-chain hardening (gate-84). Three settings that only work together:
#
#   1. min-release-age            the cooldown window, in days
#   2. min-release-age-exclude[]  first-party @conduction/* releases are not delayed,
#                                 so fresh betas still install on release day
#   3. package.json engines.npm   npm 10 does not implement min-release-age
#
# Without the exclusion the cooldown does not fail loudly: it silently resolves
# an older @conduction/* version and exits 0.
min-release-age=2
min-release-age-exclude[]=@conduction/*
