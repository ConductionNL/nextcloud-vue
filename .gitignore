# No trailing slash: `node_modules/` matches only directories, so a SYMLINK named
# node_modules is a file to git and slips through — which is how an absolute-path
# symlink got committed onto beta (8cf337bb).
node_modules
dist/
.DS_Store
*.log

# Autogenerated at build time by scripts/build-validators.js — do not commit
src/utils/validateManifestV2.compiled.js

# Docusaurus build output
docusaurus/build
.docusaurus

# Styleguide build output
styleguide/build
.styleguide
# Playwright e2e
/test-results/
/playwright-report/
/e2e/harness/node_modules/
