    <div class="stub NcButton cn-dialog-header__close" variant="tertiary" aria-label="Close" data-testid="cn-dialog-close"><span aria-hidden="true" class="material-design-icon close-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"><!--v-if--></path></svg></span></div>
  </div>
  <div class="cn-mass-delete__review" data-testid="cn-modal" data-testid-modal="cn-mass-delete-dialog" data-testid-phase="review">
    <p class="cn-dialog__sentence" data-testid="cn-mass-delete-sentence">Are you sure you want to permanently delete <strong class="cn-dialog__name">3 items</strong>? This action cannot be undone.</p>
    <p class="cn-dialog__note" role="note" data-testid="cn-mass-delete-note"><span aria-hidden="true" class="material-design-icon alert-outline-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"><!--v-if--></path></svg></span><span>The following items will be permanently deleted. Remove any items you want to keep.</span></p>
    <div class="cn-mass-delete__list">
      <div class="cn-mass-delete__item"><span class="cn-mass-delete__item-name">Report A</span>
        <div class="stub NcButton" variant="tertiary" aria-label="Remove from list"><span aria-hidden="true" class="material-design-icon close-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"><!--v-if--></path></svg></span></div>
      </div>
      <div class="cn-mass-delete__item"><span class="cn-mass-delete__item-name">Report B</span>
        <div class="stub NcButton" variant="tertiary" aria-label="Remove from list"><span aria-hidden="true" class="material-design-icon close-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"><!--v-if--></path></svg></span></div>
      </div>
      <div class="cn-mass-delete__item"><span class="cn-mass-delete__item-name">3</span>
        <div class="stub NcButton" variant="tertiary" aria-label="Remove from list"><span aria-hidden="true" class="material-design-icon close-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"><!--v-if--></path></svg></span></div>
      </div>
    </div>
    <!--v-if-->
    <div class="cn-dialog__confirm-field" data-testid="cn-confirm-value-field"><label class="cn-dialog__confirm-label" for="cn-confirm-value-4">Type to confirm</label><input id="cn-confirm-value-4" class="cn-dialog__confirm-input" type="text" autocomplete="off" spellcheck="false" aria-describedby="cn-confirm-value-4-hint" data-testid="cn-confirm-value-input" value=""><span id="cn-confirm-value-4-hint" class="cn-dialog__confirm-hint" data-testid="cn-confirm-value-hint">Type <code>delete</code> to enable the button.</span></div>
  </div>
  <div class="stub NcButton">Cancel</div>
  <div class="stub NcButton cn-dialog__confirm-pending" variant="error" disabled="true" aria-disabled="true" data-testid="cn-mass-delete-dialog-confirm"> Delete<span aria-hidden="true" class="material-design-icon trash-can-outline-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"><!--v-if--></path></svg></span></div>
</div>"
`;

