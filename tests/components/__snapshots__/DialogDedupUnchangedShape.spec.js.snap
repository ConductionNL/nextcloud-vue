exports[`CnTreeView default render collapsed with title and description 1`] = `
"<div class="cn-tree-view" data-testid="cn-tree-view">
  <header class="cn-tree-view__header">
    <h3 class="cn-tree-view__title">Pages</h3>
    <p class="cn-tree-view__description">All pages</p>
  </header>
  <ul class="cn-tree-view__root" role="tree">
    <li class="cn-tree-node" data-node-id="1" role="treeitem" aria-expanded="false" aria-selected="false">
      <div class="cn-tree-node__row" style="padding-left: 0px;"><button type="button" class="cn-tree-node__toggle" aria-label="Expand"><span class="cn-tree-node__caret">▸</span></button><span class="cn-tree-node__icon">📁</span><span class="cn-tree-node__label">Root A</span><span class="cn-tree-node__badge">2</span>
        
      </div>
      <!--v-if-->
    </li>
    <li class="cn-tree-node" data-node-id="2" role="treeitem" aria-selected="false">
      <div class="cn-tree-node__row" style="padding-left: 0px;"><span class="cn-tree-node__toggle cn-tree-node__toggle--leaf"></span>
        <!--v-if--><span class="cn-tree-node__label">Root B</span>
        <!--v-if-->
        
      </div>
      <!--v-if-->
    </li>
  </ul>
</div>"
`;

