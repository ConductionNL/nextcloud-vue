{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "1.0.0",
	"dependencies": [
		"openregister"
	],
	"walkthrough": {
		"enabled": true,
		"version": 1,
		"completionConfigKey": "walkthrough_completed_version",
		"tours": [
			{
				"id": "zaakafhandelapp:getting-started",
				"title": "Getting started",
				"trigger": "first-visit",
				"minAppVersion": "0.2.7",
				"steps": [
					{
						"id": "welcome",
						"sinceVersion": "0.2.7",
						"placement": "center",
						"title": "Welcome to ZaakAfhandelApp",
						"body": "Let's take a quick spin through your case handling — we'll create a case together so you can see how the pieces fit. You'll add the record yourself.",
						"target": {
							"kind": "page",
							"ref": "Dashboard"
						},
						"advanceOn": {
							"type": "manual"
						}
					},
					{
						"id": "go-zaken",
						"sinceVersion": "0.2.7",
						"placement": "right",
						"body": "Cases are the heart of the app — every task, document and decision hangs off a case. Open Cases from the menu to get started.",
						"task": "Click Cases in the menu",
						"target": {
							"kind": "nav-item",
							"ref": "Zaken"
						},
						"advanceOn": {
							"type": "route-match",
							"route": "Zaken"
						}
					},
					{
						"id": "create-zaak",
						"sinceVersion": "0.2.7",
						"placement": "bottom",
						"allowManualNext": true,
						"body": "Add your first case — give it a case type and save. You can attach tasks, documents and decisions to it afterwards.",
						"task": "Click New and save a case",
						"target": {
							"kind": "element",
							"ref": "index-add"
						},
						"advanceOn": {
							"type": "object-created",
							"register": "zaakafhandelapp",
							"schema": "zaak",
							"capture": {
								"zaakId": ":id"
							}
						}
					},
					{
						"id": "go-taken",
						"sinceVersion": "0.2.7",
						"placement": "right",
						"body": "Tasks are the work items that move a case forward. Open Tasks from the menu.",
						"task": "Click Tasks in the menu",
						"target": {
							"kind": "nav-item",
							"ref": "Taken"
						},
						"advanceOn": {
							"type": "route-match",
							"route": "Taken"
						}
					},
					{
						"id": "done",
						"sinceVersion": "0.2.7",
						"placement": "center",
						"title": "You're all set",
						"body": "Nicely done — your case handling has its first case. Head back to the Dashboard to watch it grow, and reopen this tour anytime from the … menu.",
						"target": {
							"kind": "page",
							"ref": "Dashboard"
						},
						"advanceOn": {
							"type": "manual"
						}
					}
				]
			}
		]
	},
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "CasesGroup",
			"label": "Cases",
			"icon": "icon-category-organization",
			"order": 20,
			"children": [
				{ "id": "Zaken",  "label": "Cases",  "icon": "icon-category-organization", "route": "Zaken",  "order": 20 },
				{ "id": "Taken",  "label": "Tasks",  "icon": "icon-checkmark",             "route": "Taken",  "order": 30 },
				{ "id": "Search", "label": "Search", "icon": "icon-search",                "route": "Search", "order": 90 }
			]
		},
		{
			"id": "RelationsGroup",
			"label": "Relations",
			"icon": "icon-group",
			"order": 40,
			"children": [
				{ "id": "Klanten",        "label": "Customers",       "icon": "icon-group",   "route": "Klanten",        "order": 40 },
				{ "id": "Medewerkers",    "label": "Employees",       "icon": "icon-user",    "route": "Medewerkers",    "order": 50 },
				{ "id": "Contactmomenten","label": "Contact moments", "icon": "icon-comment", "route": "Contactmomenten","order": 60 },
				{ "id": "Berichten",      "label": "Messages",        "icon": "icon-mail",    "route": "Berichten",      "order": 70 }
			]
		},
		{ "id": "Zaaktypen",    "label": "Case types",  "icon": "icon-files",      "route": "Zaaktypen", "section": "settings", "order": 10 },
		{ "id": "Rollen",       "label": "Roles",       "icon": "icon-user-admin", "route": "Rollen",    "section": "settings", "order": 20 },
		{ "id": "AuditTrail",   "label": "Audit trail", "icon": "icon-history",    "route": "AuditTrail","section": "settings", "order": 30 },
		{ "id": "SettingsMenu", "label": "Settings",    "icon": "icon-settings",   "route": "Settings",  "section": "settings", "order": 99 },
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://zaakafhandelapp.conduction.nl",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 91
		}
	],
	"pages": [
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://zaakafhandelapp.conduction.nl"
			}
		},
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"documentationUrl": "https://zaakafhandelapp.conduction.nl",
				"dateRange": {
					"enabled": true,
					"control": "pills",
					"showHeaderPicker": true,
					"persistKey": "zaakafhandelapp-dashboard-range",
					"default": { "preset": "month" },
					"presets": [
						{ "id": "week",    "label": "Week",    "days": 7 },
						{ "id": "month",   "label": "Maand",   "days": 30 },
						{ "id": "quarter", "label": "Kwartaal","days": 90 },
						{ "id": "year",    "label": "Jaar",    "days": 365 },
						{ "id": "all",     "label": "Alles",   "days": null }
					]
				}
			},
			"widgets": [
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 4,
					"gridHeight": 2,
					"dataSource": {
						"register": "zaakafhandelapp",
						"schema": "zaak",
						"aggregate": "count"
					},
					"props": {
						"title": "Open cases",
						"iconClass": "icon-category-organization",
						"countLabel": "cases",
						"variant": "primary",
						"route": { "name": "Zaken" },
						"dataSource": {
							"register": "zaakafhandelapp",
							"schema": "zaak",
							"aggregate": "count"
						}
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 4,
					"gridY": 0,
					"gridWidth": 4,
					"gridHeight": 2,
					"dataSource": {
						"register": "zaakafhandelapp",
						"schema": "taak",
						"aggregate": "count"
					},
					"props": {
						"title": "Open tasks",
						"iconClass": "icon-checkmark",
						"countLabel": "tasks",
						"variant": "warning",
						"route": { "name": "Taken" },
						"dataSource": {
							"register": "zaakafhandelapp",
							"schema": "taak",
							"aggregate": "count"
						}
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 8,
					"gridY": 0,
					"gridWidth": 4,
					"gridHeight": 2,
					"dataSource": {
						"register": "zaakafhandelapp",
						"schema": "zaak",
						"aggregate": "count"
					},
					"props": {
						"title": "Active cases",
						"iconClass": "icon-category-organization",
						"countLabel": "cases",
						"variant": "success",
						"route": { "name": "Zaken" },
						"dataSource": {
							"register": "zaakafhandelapp",
							"schema": "zaak",
							"aggregate": "count"
						}
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 0,
					"gridY": 2,
					"gridWidth": 4,
					"gridHeight": 2,
					"dataSource": {
						"register": "zaakafhandelapp",
						"schema": "contactmoment",
						"aggregate": "count",
						"filter": {
							"startDate": {
								"gte": "@workspace.dateFrom?",
								"lte": "@workspace.dateTo?"
							}
						}
					},
					"props": {
						"title": "Contact moments",
						"iconClass": "icon-comment",
						"countLabel": "contacts",
						"variant": "primary",
						"route": { "name": "Contactmomenten" },
						"dataSource": {
							"register": "zaakafhandelapp",
							"schema": "contactmoment",
							"aggregate": "count",
							"filter": {
								"startDate": {
									"gte": "@workspace.dateFrom?",
									"lte": "@workspace.dateTo?"
								}
							}
						}
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 4,
					"gridY": 2,
					"gridWidth": 4,
					"gridHeight": 2,
					"dataSource": {
						"register": "zaakafhandelapp",
						"schema": "klant",
						"aggregate": "count",
						"filter": {
							"subjectType": "natuurlijk_persoon"
						}
					},
					"props": {
						"title": "Persons",
						"iconClass": "icon-user",
						"countLabel": "persons",
						"variant": "primary",
						"route": { "name": "Klanten", "query": { "subjectType": "natuurlijk_persoon" } },
						"dataSource": {
							"register": "zaakafhandelapp",
							"schema": "klant",
							"aggregate": "count",
							"filter": {
								"subjectType": "natuurlijk_persoon"
							}
						}
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 8,
					"gridY": 2,
					"gridWidth": 4,
					"gridHeight": 2,
					"dataSource": {
						"register": "zaakafhandelapp",
						"schema": "klant",
						"aggregate": "count",
						"filter": {
							"subjectType": "niet_natuurlijk_persoon"
						}
					},
					"props": {
						"title": "Organisations",
						"iconClass": "icon-group",
						"countLabel": "organisations",
						"variant": "primary",
						"route": { "name": "Klanten", "query": { "subjectType": "niet_natuurlijk_persoon" } },
						"dataSource": {
							"register": "zaakafhandelapp",
							"schema": "klant",
							"aggregate": "count",
							"filter": {
								"subjectType": "niet_natuurlijk_persoon"
							}
						}
					}
				}
			]
		},
		{
			"id": "Zaken",
			"route": "/zaken",
			"type": "index",
			"title": "Cases",
			"config": {
				"register": "zaakafhandelapp",
				"schema": "zaak",
				"columns": [
					"identificatie",
					"omschrijving",
					"zaaktype",
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					},
					{
						"key": "uiterlijkeEinddatumAfdoening",
						"label": "Deadline",
						"formatter": "date"
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://zaakafhandelapp.conduction.nl"
			}
		},
		{
			"id": "ZaakDetail",
			"route": "/zaken/:id",
			"type": "detail",
			"title": "Case",
			"config": {
				"register": "zaakafhandelapp",
				"schema": "zaak",
				"_note": "CASE archetype — the operational heart of zaakgericht werken. A caseworker opens a zaak to see where it stands and what work remains, so the body leads with the case fields (status, deadlines, verantwoordelijke organisatie) 8-wide beside a Related panel, then surfaces the child collections that drive the case: open Tasks (taak.zaak=@objectId) and the case file's Documents (document.zaak=@objectId), followed by Decisions (besluit) and Results (resultaat) because closing a zaak hinges on them, and a Files leaf for the raw attachment surface. summaryAggregates give at-a-glance counts of open tasks, documents, decisions and roles. The schema declares NO email/calendar/talk linkedTypes, so no comms leaves sit on the body. ADR-049 Phase-4 dissolution assessment (updated for nextcloud-vue #89): the w3 CnObjectSidebar now resolves a per-tab widgets[].type:'object-table' to CnWidgetObjectTable and provides cnObjectContext, so besluiten — the ONE relation with a real parent-zaak-filtered endpoint (GET api/zrc/zaken/{zaakUuid}/besluiten → {results:[{url,uuid,zaak,besluit}]}, zaakUuid=@objectId) — IS now wired as an object-table sidebar tab (endpointSource url carrying @objectId in the PATH + responsePath 'results'); no whole-page migration was needed on this legacy catalog-shape detail page. The OTHER SIX stay config.sidebarTabs[].component STUBS for ENDPOINT reasons (not a renderer gap): the rollen/statussen/resultaten/zaakinformatieobjecten ZGW list controllers call CallService->index with no query forwarding so their zaak filter is dropped; taken/documenten/resultaten already render in the body via OR object-lists; berichten's bericht.zaak is unverified (relation runs through klantcontact). Per-tab detail in each tab's _note.",
				"widgets": [
					{ "id": "zaak-data", "type": "data", "title": "Case details", "content": { "columns": 2 } },
					{ "id": "zaak-related", "type": "related", "title": "Related" },
					{ "id": "zaak-taken", "type": "object-list", "title": "Tasks", "content": { "register": "zaakafhandelapp", "schema": "taak", "filter": { "zaak": "@objectId" }, "sort": { "field": "deadline", "dir": "asc" }, "columns": [ { "key": "title", "label": "Task" }, { "key": "status", "label": "Status" }, { "key": "deadline", "label": "Deadline" } ], "limit": 50, "rowRoute": "TaakDetail" } },
					{ "id": "zaak-documenten", "type": "object-list", "title": "Documents", "content": { "register": "zaakafhandelapp", "schema": "document", "filter": { "zaak": "@objectId" }, "sort": { "field": "creatiedatum", "dir": "desc" }, "columns": [ { "key": "titel", "label": "Title" }, { "key": "status", "label": "Status" }, { "key": "creatiedatum", "label": "Created" } ], "limit": 50, "rowRoute": "DocumentDetail" } },
					{ "id": "zaak-besluiten", "type": "object-list", "title": "Decisions", "content": { "register": "zaakafhandelapp", "schema": "besluit", "filter": { "zaak": "@objectId" }, "columns": [ { "key": "besluit", "label": "Decision" }, { "key": "url", "label": "Reference" } ], "limit": 25, "rowRoute": "BesluitDetail" } },
					{ "id": "zaak-resultaten", "type": "object-list", "title": "Results", "content": { "register": "zaakafhandelapp", "schema": "resultaat", "filter": { "zaak": "@objectId" }, "columns": [ { "key": "resultaattype", "label": "Result type" }, { "key": "toelichting", "label": "Explanation" } ], "limit": 25, "rowRoute": "ResultaatDetail" } },
					{ "id": "zaak-files", "type": "integration", "integrationId": "files", "title": "Attachments" },
					{ "id": "zaak-audit", "type": "audit-trail", "title": "Audit trail" }
				],
				"layout": [
					{ "id": "1", "widgetId": "zaak-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "2", "widgetId": "zaak-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 5 },
					{ "id": "3", "widgetId": "zaak-taken", "gridX": 0, "gridY": 5, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "4", "widgetId": "zaak-documenten", "gridX": 6, "gridY": 5, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "5", "widgetId": "zaak-besluiten", "gridX": 0, "gridY": 9, "gridWidth": 6, "gridHeight": 3 },
					{ "id": "6", "widgetId": "zaak-resultaten", "gridX": 6, "gridY": 9, "gridWidth": 6, "gridHeight": 3 },
					{ "id": "7", "widgetId": "zaak-files", "gridX": 0, "gridY": 12, "gridWidth": 12, "gridHeight": 4 },
					{ "id": "8", "widgetId": "zaak-audit", "gridX": 0, "gridY": 16, "gridWidth": 12, "gridHeight": 4, "showTitle": false }
				],
				"summaryAggregates": [
					{ "label": "Open tasks", "register": "zaakafhandelapp", "schema": "taak", "metric": "count", "filter": { "zaak": "@objectId" } },
					{ "label": "Documents", "register": "zaakafhandelapp", "schema": "document", "metric": "count", "filter": { "zaak": "@objectId" } },
					{ "label": "Decisions", "register": "zaakafhandelapp", "schema": "besluit", "metric": "count", "filter": { "zaak": "@objectId" } },
					{ "label": "Roles", "register": "zaakafhandelapp", "schema": "rol", "metric": "count", "filter": { "zaak": "@objectId" } }
				],
				"sidebarTabs": [
					{
						"id": "taken",
						"label": "Tasks",
						"icon": "icon-checkmark",
						"component": "ZaakTakenTab",
						"order": 20,
						"_note": "STUB (ADR-049 Phase-4): parent-zaak taken already render in the detail body (widget zaak-taken). api/taken (TakenController->objectService) forwards ?zaak=@objectId (taak.zaak=@objectId proven by the body list). Not dissolved: no object-table sidebar-tab renderer in w3 CnObjectSidebar."
					},
					{
						"id": "rollen",
						"label": "Roles",
						"icon": "icon-user-admin",
						"component": "ZaakRollenTab",
						"order": 30,
						"_note": "STUB (ADR-049 Phase-4): ZGW api/zrc/rollen exists but RollenController::index calls CallService->index with no query forwarding, so a ?zaak filter is dropped. OR api/objects/rollen?zaak=@objectId IS reachable (rol.zaak=@objectId proven by the Roles summaryAggregate). Not dissolved: no object-table sidebar-tab renderer in w3 CnObjectSidebar."
					},
					{
						"id": "documenten",
						"label": "Documents",
						"icon": "icon-files",
						"component": "ZaakDocumentenTab",
						"order": 40,
						"_note": "STUB (ADR-049 Phase-4): ZGW api/zrc/zaakinformatieobjecten exists but ZaakInformatieObjectenController::index calls CallService->index with no query forwarding, so a ?zaak filter is dropped. Parent-zaak documents already render in the detail body (widget zaak-documenten). Not dissolved: no object-table sidebar-tab renderer in w3 CnObjectSidebar."
					},
					{
						"id": "besluiten",
						"label": "Decisions",
						"icon": "icon-checkmark",
						"order": 50,
						"widgets": [
							{
								"type": "object-table",
								"props": {
									"widgetId": "zaak-besluiten-tab",
									"title": "Decisions",
									"endpointSource": {
										"url": "/apps/zaakafhandelapp/api/zrc/zaken/@objectId/besluiten",
										"responsePath": "results"
									},
									"columns": [
										{ "key": "besluit", "label": "Decision" },
										{ "key": "url", "label": "Reference" }
									],
									"emptyText": "No decisions are linked to this case yet."
								}
							}
						],
						"_note": "LIVE (ADR-049 Phase-4; nextcloud-vue #89 — CnObjectSidebar object-table tab widget): the ONE relation with a real parent-zaak-filtered endpoint — GET api/zrc/zaken/{zaakUuid}/besluiten (ZaakBesluitenController::index → {results:[{url,uuid,zaak,besluit}]}, zaakUuid=@objectId=the zaak OR id). CnObjectSidebar resolves widgets[].type:'object-table' to CnWidgetObjectTable and provides cnObjectContext {objectId,...}, so @objectId interpolates into the endpointSource.url PATH (useEndpointSource.interpolateUrlTokens); responsePath 'results' plucks the array. Columns mirror the zaakbesluit RELATION payload (besluit reference + relation url): the endpoint returns the relation, not the full besluit resource, so identificatie/besluittype/datum are NOT available here, and NO rowRoute is set — the relation payload carries no besluit id at row.id/@self.id and its 'besluit' field is a bare reference, so a row-click could not resolve a BesluitDetail target."
					},
					{
						"id": "berichten",
						"label": "Messages",
						"icon": "icon-mail",
						"component": "ZaakBerichtenTab",
						"order": 60,
						"_note": "STUB (ADR-049 Phase-4): api/berichten (BerichtenController->objectService) forwards request params but a bericht.zaak field is UNVERIFIED — the schema is seeded externally (not in-repo), bericht is absent from the body/summaryAggregates, and this relation runs through klantcontact, not a direct zaak field. Endpoint-not-built for a parent-zaak filter; also no object-table sidebar-tab renderer in w3 CnObjectSidebar."
					},
					{
						"id": "resultaten",
						"label": "Results",
						"icon": "icon-checkmark",
						"component": "ZaakResultatenTab",
						"order": 70,
						"_note": "STUB (ADR-049 Phase-4): ZGW api/zrc/resultaten exists but ResultatenController::index calls CallService->index with no query forwarding, so a ?zaak filter is dropped. Parent-zaak results already render in the detail body (widget zaak-resultaten). Not dissolved: no object-table sidebar-tab renderer in w3 CnObjectSidebar."
					},
					{
						"id": "statussen",
						"label": "Statuses",
						"icon": "icon-history",
						"component": "ZaakStatussenTab",
						"order": 80,
						"_note": "STUB (ADR-049 Phase-4): ZGW api/zrc/statussen exists but StatusenController::index calls CallService->index with no query forwarding, so a ?zaak filter is dropped; a status.zaak field is also unverified (status absent from body/summaryAggregates). Endpoint-not-built for a parent-zaak filter; also no object-table sidebar-tab renderer in w3 CnObjectSidebar."
					}
				],
				"documentationUrl": "https://zaakafhandelapp.conduction.nl",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "Taken",
			"route": "/taken",
			"type": "index",
			"title": "Tasks",
			"config": {
				"register": "zaakafhandelapp",
				"schema": "taak",
				"columns": [
					"title",
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					},
					{
						"key": "priority",
						"label": "Priority",
						"widget": "badge"
					},
					{
						"key": "dueDate",
