{
  "openapi": "3.1.0",
  "info": { "title": "Vergunningen", "version": "1.4.0", "description": "Permits.\n![x](https://example.org/p.png)" },
  "servers": [{ "url": "https://cloud.example.nl/apps/openregister/api" }],
  "externalDocs": { "url": "javascript:alert(1)", "description": "bad" },
  "components": {
    "securitySchemes": { "basicAuth": { "type": "http", "scheme": "basic" } },
    "schemas": {
      "permit": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 80, "description": "Name of the permit" },
          "status": { "type": "string", "enum": ["open", "granted"] },
          "applicant": { "$ref": "#/components/schemas/applicant" },
          "address": { "$ref": "https://example.org/bag.json#/Adres" },
          "parent": { "$ref": "#/components/schemas/permit" }
        }
      },
      "applicant": { "type": "object", "properties": { "name": { "type": "string" } } }
    }
  },
  "paths": {
    "/objects/vergunningen/permit": {
      "get": {
        "tags": ["permit"], "summary": "List permits",
        "parameters": [{ "name": "_limit", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Page size" }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/permit" } } } } } }
      },
      "post": {
        "tags": ["permit"], "summary": "Create a permit",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/permit" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/objects/vergunningen/permit/{id}": {
      "delete": { "tags": ["permit"], "summary": "Delete a permit", "responses": { "204": { "description": "Gone" } } }
    },
    "/objects/vergunningen/applicant": {
      "get": { "tags": ["applicant"], "summary": "List applicants", "responses": { "200": { "description": "OK" } } }
    },
    "/health": { "get": { "summary": "Health", "responses": { "200": { "description": "OK" } } } }
  }
}
