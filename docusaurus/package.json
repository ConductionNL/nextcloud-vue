{
  "name": "nextcloud-vue-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run prebuild:docs",
    "build": "docusaurus build",
    "ci": "npm ci && npm run build",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "docusaurus": "docusaurus",
    "prebuild:docs": "vue-docgen --configFile docgen.config.js",
    "serve": "docusaurus serve",
    "prestart": "npm run prebuild:docs",
